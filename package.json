{
  "name": "vitest-browser-three",
  "version": "0.0.3",
  "description": "GPU-native assertions for three.js TSL expressions in Vitest Browser Mode.",
  "keywords": [
    "browser",
    "gpu",
    "shader",
    "testing",
    "three",
    "threejs",
    "tsl",
    "vitest",
    "webgpu"
  ],
  "homepage": "https://github.com/linbingquan/vitest-browser-three#readme",
  "bugs": {
    "url": "https://github.com/linbingquan/vitest-browser-three/issues"
  },
  "license": "MIT",
  "author": "linbingquan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linbingquan/vitest-browser-three.git"
  },
  "files": [
    "dist",
    "docs/guide",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./pure": {
      "types": "./dist/pure.d.mts",
      "import": "./dist/pure.mjs",
      "default": "./dist/pure.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "release": "vp exec bumpp",
    "prepublishOnly": "vp run build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "bumpp": "^11.1.0",
    "playwright": "^1.63.0",
    "three": "^0.185.1",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "three": ">=0.185.0",
    "vitest": ">=4.0.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  }
}
